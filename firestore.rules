// Reglas de seguridad de Firestore para el Secret Santa 2026.
// Se pegan en: Firebase > Firestore Database > Reglas > Publicar.
// Este archivo es solo una copia para tenerlas guardadas en el repositorio.
//
// Recordatorio (Opción B): Firestore no sabe quién es quién, porque el PIN se valida en el navegador.
// Estas reglas limitan QUÉ se puede guardar, pero no QUIÉN lo guarda.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Se pueden editar deseos hasta el domingo 8 de noviembre de 2026, 8:00 a. m. de Colombia
    // (1794142800000 = esa fecha en milisegundos; debe coincidir con FECHA_SORTEO en index.html)
    // y mientras config/sorteo no tenga realizado == true.
    function sorteoAbierto() {
      return request.time < timestamp.value(1794142800000)
        && (!exists(/databases/$(database)/documents/config/sorteo)
            || get(/databases/$(database)/documents/config/sorteo).data.realizado != true);
    }

    // Nombre de documento razonable: letras (con tildes), números y espacios, máximo 30 caracteres
    function nombreValido(nombre) {
      return nombre.matches('^[A-Za-z0-9ÁÉÍÓÚÜÑáéíóúüñ ]{1,30}$');
    }

    // deseos/{nombre} = {
    //   opciones: lista de 1 a 10 { texto, link, precio },
    //   combos: lista de hasta 20 { opciones: [índices] },
    //   actualizado: hora del servidor
    // }
    // (Las reglas no pueden revisar cada opción una por una; la página limita textos, links y precios.)
    match /deseos/{nombre} {
      allow get: if nombreValido(nombre);
      allow list: if false;              // nadie puede descargar todos los deseos de una vez
      allow create, update: if nombreValido(nombre)
        && sorteoAbierto()
        && request.resource.data.keys().hasOnly(['opciones', 'combos', 'actualizado'])
        && request.resource.data.opciones is list
        && request.resource.data.opciones.size() >= 1
        && request.resource.data.opciones.size() <= 10
        && request.resource.data.combos is list
        && request.resource.data.combos.size() <= 20
        && request.resource.data.actualizado == request.time;
      allow delete: if false;
    }

    // correos/{nombre} = { correo, creado } — cada participante lo registra la primera vez que entra.
    // Solo se puede CREAR una vez; nadie puede cambiarlo ni borrarlo desde la página
    // (si alguien se equivocó, el organizador lo corrige o borra desde la consola de Firebase).
    match /correos/{nombre} {
      allow get: if nombreValido(nombre);
      allow list, update, delete: if false;
      allow create: if nombreValido(nombre)
        && request.resource.data.keys().hasOnly(['correo', 'creado'])
        && request.resource.data.correo is string
        && request.resource.data.correo.size() <= 100
        && request.resource.data.correo.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && request.resource.data.creado == request.time;
    }

    // config/sorteo = { realizado: true, fecha } — lo escribe la página al hacer el sorteo REAL,
    // y solo se permite desde la fecha del sorteo (antes de eso, los sorteos son de prueba y no guardan nada)
    match /config/{docId} {
      allow get: if true;
      allow list, delete: if false;
      allow create, update: if docId == 'sorteo'
        && request.time >= timestamp.value(1794142800000)
        && request.resource.data.keys().hasOnly(['realizado', 'fecha'])
        && request.resource.data.realizado == true
        && request.resource.data.fecha == request.time;
    }

    // Todo lo demás queda cerrado
  }
}
