// Reglas de seguridad de Firestore para el Secret Santa 2026.
// Se pegan en: Firebase > Firestore Database > Reglas > Publicar.
// Este archivo es solo una copia para tenerlas guardadas en el repositorio.
//
// Recordatorio (Opción B): Firestore no sabe quién es quién, porque el PIN se valida en el navegador.
// Estas reglas limitan QUÉ se puede guardar, pero no QUIÉN lo guarda.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Se pueden editar deseos hasta el domingo 8 de noviembre de 2026, 8:00 a. m. de Colombia
    // (1794142800000 = esa fecha en milisegundos; debe coincidir con FECHA_SORTEO en index.html)
    // y mientras config/sorteo no tenga realizado == true.
    function sorteoAbierto() {
      return request.time < timestamp.value(1794142800000)
        && (!exists(/databases/$(database)/documents/config/sorteo)
            || get(/databases/$(database)/documents/config/sorteo).data.realizado != true);
    }

    // Nombre de documento razonable: letras (con tildes), números y espacios, máximo 30 caracteres
    function nombreValido(nombre) {
      return nombre.matches('^[A-Za-z0-9ÁÉÍÓÚÜÑáéíóúüñ ]{1,30}$');
    }

    // deseos/{nombre} = { deseo: texto de 1 a 200 caracteres, actualizado: hora del servidor }
    match /deseos/{nombre} {
      allow get: if nombreValido(nombre);
      allow list: if false;              // nadie puede descargar todos los deseos de una vez
      allow create, update: if nombreValido(nombre)
        && sorteoAbierto()
        && request.resource.data.keys().hasOnly(['deseo', 'actualizado'])
        && request.resource.data.deseo is string
        && request.resource.data.deseo.size() > 0
        && request.resource.data.deseo.size() <= 200
        && request.resource.data.actualizado == request.time;
      allow delete: if false;
    }

    // config/sorteo = { presupuesto, fecha_entrega, realizado } — solo se edita desde la consola de Firebase
    match /config/{docId} {
      allow get: if true;
      allow list, write: if false;
    }

    // Todo lo demás queda cerrado
  }
}
